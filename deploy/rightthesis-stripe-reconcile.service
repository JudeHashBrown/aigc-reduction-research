[Unit]
Description=Reconcile RightThesis live Stripe orders and flag disputes
After=rightthesis.service
OnFailure=rightthesis-backup-alert@%n.service

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/rightthesis
ExecStart=/home/admin/rightthesis/.venv/bin/python scripts/reconcile_stripe_orders.py --database /home/admin/rightthesis/data/billing.sqlite3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/rightthesis/data
PrivateTmp=true
