[Unit]
Description=Verify today's RightThesis backup and OSS upload receipt
OnFailure=rightthesis-backup-alert@%n.service

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/rightthesis
ExecStart=/home/admin/rightthesis/.venv/bin/python scripts/check_backup_health.py --backup-dir /home/admin/rightthesis-backups --key-file /home/admin/.config/rightthesis/backup.key
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
