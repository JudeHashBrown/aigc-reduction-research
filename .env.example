# Copy to .env. Never commit the real key.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_your_key
LLM_MODEL=gpt-5.6-sol

# Local commercial-MVP settings. "mock" never charges real money.
PAYMENT_PROVIDER=mock
BILLING_DB=data/billing.sqlite3

# Access mode: local (single developer), trial (anonymous browser sessions),
# or accounts (verified email + optional Google OAuth).
AUTH_MODE=local

# Production-shaped account sessions. Keep the service bound to loopback and
# put an HTTPS reverse proxy in front when PUBLIC_ORIGIN is not localhost.
AUTH_SESSION_SECRET_FILE=data/auth_session_secret
# Optional alternative for secret managers; must contain at least 32 bytes.
# AUTH_SESSION_SECRET=
AUTH_SESSION_DAYS=7
PUBLIC_ORIGIN=

# Google OAuth. Register the exact callback URI in Google Cloud Console.
# Example for local development:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Email/password accounts use Argon2id. Registration and password reset both
# require a one-time email code. "console" is loopback-development only and
# prints that code in the server terminal; use smtp for any shared environment.
# New passwords need 6-128 characters with uppercase, lowercase and digits.
AUTH_EMAIL_DELIVERY=console
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SSL=0
AUTH_SMTP_STARTTLS=1
# Optional for local networks that block direct SMTP. HTTP CONNECT only;
# keep unset when the server can connect to SMTP directly.
AUTH_SMTP_PROXY_URL=

# 腾讯企业邮箱发验证码（替换上方对应值；不要把授权码提交到 Git）：
# AUTH_EMAIL_DELIVERY=smtp
# AUTH_EMAIL_FROM=verify@your-domain.example
# AUTH_SMTP_HOST=smtp.exmail.qq.com
# AUTH_SMTP_PORT=465
# AUTH_SMTP_USERNAME=verify@your-domain.example
# AUTH_SMTP_PASSWORD=your-client-authorization-code
# AUTH_SMTP_SSL=1
# AUTH_SMTP_STARTTLS=0
# AUTH_SMTP_PROXY_URL=http://127.0.0.1:7890

# Optional anonymous trial. Leave disabled for the original local-demo mode.
# Kept for backward compatibility when AUTH_MODE is omitted. Prefer
# AUTH_MODE=trial for new configuration.
TRIAL_MODE=0
TRIAL_SESSION_SECRET_FILE=data/trial_session_secret
# Exact public HTTPS origin used by the local reverse proxy (no path).
# Example: https://your-machine.your-tailnet.ts.net
TRIAL_PUBLIC_ORIGIN=
# Total initial balance, including the existing 800-character welcome grant.
TRIAL_CREDITS=3000
TRIAL_MAX_CHARS=3000
TRIAL_SESSION_DAYS=7

# With TRIAL_MODE=1 every browser receives an isolated signed guest account.
# Keep 127.0.0.1 for local or Tailscale Serve. Non-loopback binding is allowed
# only for anonymous trial mode and only with an exact LAN origin below.
TRIAL_BIND_HOST=127.0.0.1
# Example (port must equal the server port): http://192.168.1.23:8765
TRIAL_LAN_ORIGIN=

# Stripe Checkout: keep secrets only in the server's private .env (never in Git,
# chat, screenshots, or the frontend). A CLI-forwarded test webhook and a
# Dashboard live webhook have DIFFERENT whsec_ values.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_replace_locally
# STRIPE_WEBHOOK_SECRET=whsec_replace_locally
# STRIPE_LIVE_ENABLED=0
# To accept real payments, prefer a LIVE rk_live_ key with only the permissions
# needed to create Checkout Sessions (a sk_live_ key also works), and a LIVE webhook
# signing secret, PUBLIC_ORIGIN=https://rightthesis.com and STRIPE_LIVE_ENABLED=1.
# The live endpoint is https://rightthesis.com/api/billing/stripe/webhook.
